# ============================================================
# Sovereign Advisor MCP Server — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# All values here are placeholders — real credentials are
# stored in Azure Key Vault in production.
# ============================================================

# ------------------------------------------------------------
# MCP SERVER IDENTITY
# Used in the server info block that MCP clients (e.g. Azure
# AI Foundry) receive when they connect to this tool server.
# ------------------------------------------------------------
MCP_SERVER_NAME=sovereign-advisor-mcp
MCP_SERVER_VERSION=1.0.0

# ------------------------------------------------------------
# LOGGING
# Set to DEBUG during local development, INFO in production.
# Accepted values: DEBUG | INFO | WARNING | ERROR
# ------------------------------------------------------------
LOG_LEVEL=INFO

# ------------------------------------------------------------
# AZURE FUNCTIONS (PRODUCTION ONLY)
# These are injected automatically by the Azure Functions
# runtime when deployed. They are listed here for reference
# so the local .env can replicate the same variable names.
# Leave blank for local uvicorn / stdio development.
# ------------------------------------------------------------
AZURE_FUNCTIONS_ENVIRONMENT=Development
WEBSITE_SITE_NAME=sovereign-advisor-mcp

# ------------------------------------------------------------
# FUTURE: AZURE OPENAI (for any server-side embedding or
# validation calls — not needed in Phase 1)
# ------------------------------------------------------------
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=<your-key>
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
